# Claude (without it the platform runs on a deterministic demo provider)
ANTHROPIC_API_KEY=
# Optional: default model for every agent (per-agent and per-node overrides exist)
BOTLOOM_MODEL=claude-opus-5-5

# Protect the builder API (recommended in production)
BOTLOOM_ADMIN_TOKEN=

# Google Workspace: either a service account JSON (one line) ...
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE=
# ... or an OAuth refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Local development without a public URL: long-poll Telegram instead of webhooks
BOTLOOM_TELEGRAM_POLLING=0
# Allow the HTTP node to call private network addresses (off by default, SSRF guard)
BOTLOOM_ALLOW_PRIVATE_HTTP=0
PORT=8787
